# GitHub Packages Registry for @inform-elevate packages
@inform-elevate:registry=https://npm.pkg.github.com

# NPM Security Configuration - Enhanced Protection Against Supply Chain Attacks
# Enable strict SSL verification
strict-ssl=true

# Enable automatic security audits
audit=true

# Disable funding messages to reduce noise
fund=false

# Default registry (ensures legitimate packages)
registry=https://registry.npmjs.org/

# Enable package-lock for integrity
package-lock=true

# Security-focused dependency management
save-exact=true
engine-strict=true

# Enhanced logging for security monitoring
loglevel=warn

# CRITICAL: Disable automatic execution of package scripts (prevents auto-replicating worms)
ignore-scripts=true

# Enable integrity checks to detect tampered packages
check-integrity=true

# Additional security measures
prefer-offline=false
cache-verify=true